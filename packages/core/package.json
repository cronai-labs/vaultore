{
	"name": "@vaultore/core",
	"version": "0.1.1",
	"description": "Core engine for VaultOre - workflow parsing, execution, and scheduling",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.js",
			"types": "./src/index.ts"
		},
		"./parser": {
			"import": "./dist/parser/index.mjs",
			"require": "./dist/parser/index.js",
			"types": "./src/parser/index.ts"
		},
		"./executor": {
			"import": "./dist/executor/index.mjs",
			"require": "./dist/executor/index.js",
			"types": "./src/executor/index.ts"
		},
		"./runtime": {
			"import": "./dist/runtime/index.mjs",
			"require": "./dist/runtime/index.js",
			"types": "./src/runtime/index.ts"
		},
		"./providers": {
			"import": "./dist/providers/index.mjs",
			"require": "./dist/providers/index.js",
			"types": "./src/providers/index.ts"
		},
		"./scheduler": {
			"import": "./dist/scheduler/index.mjs",
			"require": "./dist/scheduler/index.js",
			"types": "./src/scheduler/index.ts"
		},
		"./vault": {
			"import": "./dist/vault/index.mjs",
			"require": "./dist/vault/index.js",
			"types": "./src/vault/index.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node ./node_modules/tsup/dist/cli-default.js",
		"dev": "node ./node_modules/tsup/dist/cli-default.js --watch",
		"test": "vitest --run --passWithNoTests",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest --coverage",
		"test:integration": "vitest --run --config vitest.integration.config.ts",
		"test:canonical": "vitest --run --config vitest.canonical.config.ts --passWithNoTests",
		"typecheck": "tsc -p tsconfig.test.json",
		"lint": "cd ../.. && eslint --config packages/core/eslint.config.mjs packages/core",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@babel/parser": "^7.29.9",
		"yaml": "^2.9.1",
		"cron-parser": "^5.10.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"tsup": "^8.0.0",
		"typescript": "^5.3.0",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"typescript": ">=5.0.0"
	}
}
