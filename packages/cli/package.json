{
	"name": "@vaultore/cli",
	"version": "0.1.0",
	"description": "Standalone CLI and headless agent for VaultOre workflows",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"vaultore": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest --run --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"lint": "eslint ."
	},
	"dependencies": {
		"@vaultore/core": "workspace:*"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"eslint": "^9.39.4",
		"globals": "^17.11.0",
		"tsup": "^8.0.0",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.10"
	}
}
